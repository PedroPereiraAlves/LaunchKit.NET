{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=launchkit.db"
  },
  "Jwt": {
    "Issuer": "LaunchKit.NET",
    "Audience": "LaunchKit.NET",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AuthRateLimit": {
    "PermitLimit": 20,
    "WindowSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
